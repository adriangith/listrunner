{
  "schemaVersion": 4, "id": "ocado", "displayName": "Ocado",
  "serviceArea": {"countryCodes": ["GB"]},
  "homepage": "https://www.ocado.com",
  "allowedHosts": ["www.ocado.com", "ocado.com"],
  "search": {"strategy": "urlTemplate", "template": "https://www.ocado.com/search?q={query}"},
  "addedColor": {"red": 88, "green": 49, "blue": 127},
  "capabilities": {"search": true, "cartDetection": false, "cartUndo": false},
  "cart": {
    "strategy": "profiled", "identityStrategy": "numericURLSuffix",
    "tileSelector": "[data-test='fop-body']", "linkSelector": "a[data-test='fop-product-link']",
    "productURLPattern": "^/products/[^/]+/(\\d{1,32})/?$",
    "addSelector": "button[data-synthetics='add-button']",
    "addLabelPatterns": ["^add .+ to trolley$", "^increase quantity of .+ in trolley$"],
    "quantitySelector": "input[data-test='quantity-in-basket']", "emptyStatusSelector": "button[data-test='counter-button']",
    "emptyStatusText": "Add", "decrementLabelPattern": "^decrease quantity of .+ in trolley$",
    "profiles": [{
      "id": "product-card", "scope": "productCard", "identity": "cardLink",
      "containerSelector": "[data-test='fop-body']", "titleSelector": "h3[data-test='fop-title']",
      "addSelector": "button[data-synthetics='add-button']",
      "addLabelPatterns": ["^add .+ to trolley$", "^increase quantity of .+ in trolley$"],
      "confirmation": "quantityIncrease", "confirmationWindowMS": 15000,
      "quantitySelector": "input[data-test='quantity-in-basket']", "emptyStatusText": "Add"
    }]
  }
}
