{
  "schemaVersion": 3,
  "id": "kmart",
  "displayName": "Kmart",
  "serviceArea": {"countryCodes": ["AU"]},
  "homepage": "https://www.kmart.com.au",
  "allowedHosts": ["www.kmart.com.au", "kmart.com.au"],
  "search": {"strategy": "urlTemplate", "template": "https://www.kmart.com.au/search/?searchTerm={query}"},
  "addedColor": {"red": 0, "green": 91, "blue": 172},
  "brandColors": {
    "primary": {"red": 0, "green": 91, "blue": 172},
    "highlight": {"red": 227, "green": 24, "blue": 55}
  },
  "capabilities": {"search": true, "cartDetection": true, "cartUndo": false},
  "cart": {
    "strategy": "profiled",
    "identityStrategy": "numericURLSuffix",
    "tileSelector": "li",
    "linkSelector": "a[href*='/product/']",
    "productURLPattern": "/product/[^/?#]+-(\\d{1,32})(?:[/?#]|$)",
    "addSelector": "button",
    "addLabelPatterns": ["^add$", "^add to bag$", "^add .+ to bag(?:\\s*add)?$", "^increase quantity$"],
    "quantitySelector": "input[aria-label=\"Quantity\"],input[name=\"quantity\"]",
    "emptyStatusSelector": "button",
    "emptyStatusText": "Add",
    "decrementLabelPattern": "^decrease quantity$",
    "profiles": [
      {
        "id": "product-card",
        "scope": "productCard",
        "identity": "cardLink",
        "containerSelector": "div",
        "titleSelector": "p",
        "addSelector": "button[data-testid=\"quick-product-button\"]",
        "addLabelPatterns": ["^add$", "^add to bag$", "^add .+ to bag(?:\\s*add)?$"],
        "confirmation": "productReceipt",
        "confirmationWindowMS": 8000,
        "receipt": {"selector": "body", "successText": "Added to your bag", "quantityPattern": "\\bqty\\s+(\\d{1,4})\\b"}
      },
      {
        "id": "product-page",
        "scope": "productPage",
        "identity": "pageURL",
        "containerSelector": ".product-button-container",
        "titleSelector": "h1[data-testid=\"product-title\"]",
        "addSelector": "button[data-testid=\"product-button\"]",
        "addLabelPatterns": ["^add to bag$"],
        "confirmation": "productReceipt",
        "confirmationWindowMS": 8000,
        "receipt": {"selector": "body", "successText": "Added to your bag", "quantityPattern": "\\bqty\\s+(\\d{1,4})\\b"}
      }
    ]
  }
}
