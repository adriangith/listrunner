{
  "schemaVersion": 3,
  "id": "bigW",
  "displayName": "BIG W",
  "serviceArea": {"countryCodes": ["AU"]},
  "homepage": "https://www.bigw.com.au",
  "allowedHosts": ["www.bigw.com.au", "bigw.com.au"],
  "search": {"strategy": "urlTemplate", "template": "https://www.bigw.com.au/search?text={query}"},
  "addedColor": {"red": 0, "green": 107, "blue": 182},
  "capabilities": {"search": true, "cartDetection": true, "cartUndo": true},
  "cart": {
    "strategy": "profiled",
    "identityStrategy": "numericURLSuffix",
    "tileSelector": "article[data-testid=\"product-tile\"]",
    "linkSelector": "a[href*='/p/']",
    "productURLPattern": "/product/[^/?#]+/p/(\\d{1,32})(?:[/?#]|$)",
    "addSelector": "button[data-optly-add-to-cart-button=\"true\"],button[data-optly-increase-quantity-button=\"true\"]",
    "addLabelPatterns": ["^add to cart$", "^increase quantity by 1$"],
    "quantitySelector": "input[aria-label=\"update quantity\"]",
    "emptyStatusSelector": "button[data-optly-add-to-cart-button=\"true\"]",
    "emptyStatusText": "Add to cart",
    "decrementLabelPattern": "^decrease quantity by 1$",
    "profiles": [
      {
        "id": "product-card",
        "scope": "productCard",
        "identity": "cardLink",
        "containerSelector": "article[data-testid=\"product-tile\"]",
        "titleSelector": "p[data-optly-product-tile-name=\"true\"]",
        "addSelector": "button[data-di-id=\"plp--add-to-cart\"],button[data-optly-increase-quantity-button=\"true\"]",
        "addLabelPatterns": ["^add to cart$", "^increase quantity by 1$"],
        "confirmation": "quantityIncrease",
        "confirmationWindowMS": 8000,
        "setupPrompt": {"selector": "[role=\"dialog\"]", "textPattern": "postcode|choose.*store|select.*store", "maximumWaitMS": 300000},
        "quantitySelector": "input[aria-label=\"update quantity\"]",
        "emptyStatusText": "Add to cart",
        "undo": {"decrementSelector": "button[data-optly-decrease-quantity-button=\"true\"]", "decrementLabelPattern": "^decrease quantity by 1$"}
      },
      {
        "id": "product-page",
        "scope": "productPage",
        "identity": "pageURL",
        "containerSelector": "div[class*=\"ProductActionButtons_ButtonsGrid\"]",
        "titleSelector": "h1#product-title",
        "addSelector": "button[data-di-id=\"pdp--add-to-cart\"],button[data-optly-increase-quantity-button=\"true\"]",
        "addLabelPatterns": ["^add to cart$", "^increase quantity by 1$"],
        "confirmation": "quantityIncrease",
        "confirmationWindowMS": 8000,
        "setupPrompt": {"selector": "[role=\"dialog\"]", "textPattern": "postcode|choose.*store|select.*store", "maximumWaitMS": 300000},
        "quantitySelector": "input[aria-label=\"update quantity\"]",
        "emptyStatusText": "Add to cart",
        "undo": {"decrementSelector": "button[data-optly-decrease-quantity-button=\"true\"]", "decrementLabelPattern": "^decrease quantity by 1$"}
      }
    ]
  }
}
